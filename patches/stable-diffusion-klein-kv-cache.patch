+        return ggml_view_4d(ctx,
+                            x,
+                            x->ne[0],
+                            x->ne[1],
+                            x->ne[2],
+                            length,
+                            x->nb[1],
+                            x->nb[2],
+                            x->nb[3],
+                            start * x->nb[3]);
+    }
+
+    __STATIC_INLINE__ ggml_tensor* reorder_klein_kv_positions(GGMLRunnerContext* ctx,
+                                                               ggml_tensor* pe,
+                                                               int64_t text_tokens,
+                                                               int64_t reference_tokens,
+                                                               int64_t image_tokens) {
+        auto text = position_view_4d(ctx->ggml_ctx, pe, 0, text_tokens);
+        auto image = position_view_4d(ctx->ggml_ctx, pe, text_tokens, image_tokens);
+        auto reference = position_view_4d(ctx->ggml_ctx,
+                                          pe,
+                                          text_tokens + image_tokens,
+                                          reference_tokens);
+        return ggml_concat(ctx->ggml_ctx,
+                           ggml_concat(ctx->ggml_ctx, text, reference, 3),
+                           image,
+                           3);
+    }
+
+    __STATIC_INLINE__ ggml_tensor* repeat_modulation(GGMLRunnerContext* ctx,
+                                                      ggml_tensor* value,
+                                                      int64_t tokens) {
+        auto expanded = ggml_reshape_3d(ctx->ggml_ctx,
+                                        value,
+                                        value->ne[0],
+                                        1,
+                                        value->ne[1]);
+        return ggml_repeat(ctx->ggml_ctx,
+                           expanded,
+                           ggml_new_tensor_3d(ctx->ggml_ctx,
+                                              value->type,
+                                              value->ne[0],
+                                              tokens,
+                                              value->ne[1]));
+    }
+
+    __STATIC_INLINE__ ggml_tensor* blend_double_modulation_value(GGMLRunnerContext* ctx,
+                                                                  ggml_tensor* image_value,
+                                                                  ggml_tensor* reference_value,
+                                                                  int64_t reference_tokens,
+                                                                  int64_t image_tokens) {
+        auto ref = repeat_modulation(ctx, reference_value, reference_tokens);
+        auto img = repeat_modulation(ctx, image_value, image_tokens);
+        return ggml_concat(ctx->ggml_ctx, ref, img, 1);
+    }
+
+    __STATIC_INLINE__ ggml_tensor* blend_single_modulation_value(GGMLRunnerContext* ctx,
+                                                                  ggml_tensor* image_value,
+                                                                  ggml_tensor* reference_value,
+                                                                  int64_t text_tokens,
+                                                                  int64_t reference_tokens,
+                                                                  int64_t image_tokens) {
+        auto txt = repeat_modulation(ctx, image_value, text_tokens);
+        auto ref = repeat_modulation(ctx, reference_value, reference_tokens);
+        auto img = repeat_modulation(ctx, image_value, image_tokens);
+        return ggml_concat(ctx->ggml_ctx,
+                           ggml_concat(ctx->ggml_ctx, txt, ref, 1),
+                           img,
+                           1);
+    }
+
+    __STATIC_INLINE__ ModulationOut blend_double_modulation(GGMLRunnerContext* ctx,
+                                                             const ModulationOut& image_mod,
+                                                             const ModulationOut& reference_mod,
+                                                             int64_t reference_tokens,
+                                                             int64_t image_tokens) {
+        return {
+            blend_double_modulation_value(ctx, image_mod.shift, reference_mod.shift, reference_tokens, image_tokens),
+            blend_double_modulation_value(ctx, image_mod.scale, reference_mod.scale, reference_tokens, image_tokens),
+            blend_double_modulation_value(ctx, image_mod.gate, reference_mod.gate, reference_tokens, image_tokens),
+        };
+    }
+
+    __STATIC_INLINE__ ModulationOut blend_single_modulation(GGMLRunnerContext* ctx,
+                                                             const ModulationOut& image_mod,
+                                                             const ModulationOut& reference_mod,
+                                                             int64_t text_tokens,
+                                                             int64_t reference_tokens,
+                                                             int64_t image_tokens) {
+        return {
+            blend_single_modulation_value(ctx, image_mod.shift, reference_mod.shift, text_tokens, reference_tokens, image_tokens),
+            blend_single_modulation_value(ctx, image_mod.scale, reference_mod.scale, text_tokens, reference_tokens, image_tokens),
+            blend_single_modulation_value(ctx, image_mod.gate, reference_mod.gate, text_tokens, reference_tokens, image_tokens),
+        };
+    }
+
+    __STATIC_INLINE__ ggml_tensor* klein_kv_attention(GGMLRunnerContext* ctx,
+                                                       ggml_tensor* q,
+                                                       ggml_tensor* k,
+                                                       ggml_tensor* v,
+                                                       ggml_tensor* pe,
+                                                       int64_t num_heads,
+                                                       int64_t text_tokens,
+                                                       int64_t reference_tokens,
+                                                       bool extract,
+                                                       const std::string& cache_prefix,
+                                                       const std::string& cache_group) {
+        (void) cache_group;
+        q = Rope::apply_rope(ctx->ggml_ctx, q, pe, true);
+        k = Rope::apply_rope(ctx->ggml_ctx, k, pe, true);
+
+        ggml_tensor* reference_k = nullptr;
+        ggml_tensor* reference_v = nullptr;
+        if (extract) {
+            reference_k = ggml_cont(ctx->ggml_ctx,
+                                    token_view_3d(ctx->ggml_ctx, k, text_tokens, reference_tokens));
+            reference_v = ggml_cont(ctx->ggml_ctx,
+                                    token_view_4d(ctx->ggml_ctx, v, text_tokens, reference_tokens));
+            ggml_set_output(reference_k);
+            ggml_set_output(reference_v);
+            ctx->persist_cache_tensor(cache_prefix + ".k", reference_k);
+            ctx->persist_cache_tensor(cache_prefix + ".v", reference_v);
+        } else {
+            reference_k = ctx->load_cache_tensor(cache_prefix + ".k");
+            reference_v = ctx->load_cache_tensor(cache_prefix + ".v");
+            GGML_ASSERT(reference_k != nullptr && reference_v != nullptr);
+            reference_tokens = reference_k->ne[1];
+        }
+
+        const int64_t current_reference_tokens = extract ? reference_tokens : 0;
+        const int64_t current_image_start       = text_tokens + current_reference_tokens;
+        const int64_t image_tokens              = q->ne[1] - current_image_start;
+
+        ggml_tensor* q_main = q;
+        if (extract) {
+            auto q_text  = token_view_3d(ctx->ggml_ctx, q, 0, text_tokens);
+            auto q_image = token_view_3d(ctx->ggml_ctx, q, current_image_start, image_tokens);
+            q_main       = ggml_concat(ctx->ggml_ctx, q_text, q_image, 1);
+        }
+
+        ggml_tensor* k_all = k;
+        ggml_tensor* v_all = v;
+        if (!extract) {
+            // Cached attention is unmasked and reference RoPE has already been
+            // applied, so paired reference K/V entries may be appended after
+            // the current text+image entries. This preserves the mathematical
+            // attention result while replacing two nested device copies with
+            // one contiguous copy per tensor.
+            k_all        = ggml_concat(ctx->ggml_ctx, k, reference_k, 1);
+            v_all        = ggml_concat(ctx->ggml_ctx, v, reference_v, 2);
+        }
+
+        auto main_attention = ggml_ext_attention_ext(ctx->ggml_ctx,
+                                                      ctx->backend,
+                                                      q_main,
+                                                      k_all,
+                                                      v_all,
+                                                      num_heads,
+                                                      nullptr,
+                                                      true,
+                                                      ctx->flash_attn_enabled);
+        if (!extract) {
+            return main_attention;
+        }
+
+        auto q_reference = token_view_3d(ctx->ggml_ctx, q, text_tokens, reference_tokens);
+        auto reference_attention = ggml_ext_attention_ext(ctx->ggml_ctx,
+                                                           ctx->backend,
+                                                           q_reference,
+                                                           reference_k,
+                                                           reference_v,
+                                                           num_heads,
+                                                           nullptr,
+                                                           true,
+                                                           ctx->flash_attn_enabled);
+        auto text_attention  = token_view_3d(ctx->ggml_ctx, main_attention, 0, text_tokens);
+        auto image_attention = token_view_3d(ctx->ggml_ctx, main_attention, text_tokens, image_tokens);
+        return ggml_concat(ctx->ggml_ctx,
+                           ggml_concat(ctx->ggml_ctx, text_attention, reference_attention, 1),
+                           image_attention,
+                           1);
+    }
