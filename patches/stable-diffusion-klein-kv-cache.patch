+    __STATIC_INLINE__ ggml_tensor* klein_kv_attention(GGMLRunnerContext* ctx,
+                                                       ggml_tensor* q,
+                                                       ggml_tensor* k,
+                                                       ggml_tensor* v,
+                                                       ggml_tensor* pe,
+                                                       int64_t num_heads,
+                                                       int64_t text_tokens,
+                                                       int64_t reference_tokens,
+                                                       bool extract,
+                                                       const std::string& cache_prefix) {
+        q = Rope::apply_rope(ctx->ggml_ctx, q, pe, true);
+        k = Rope::apply_rope(ctx->ggml_ctx, k, pe, true);
+
+        ggml_tensor* reference_k = nullptr;
+        ggml_tensor* reference_v = nullptr;
+        if (extract) {
+            reference_k = token_view_3d(ctx->ggml_ctx, k, text_tokens, reference_tokens);
+            reference_v = token_view_4d(ctx->ggml_ctx, v, text_tokens, reference_tokens);
+            ctx->persist_cache_tensor(cache_prefix + ".k", reference_k);
+            ctx->persist_cache_tensor(cache_prefix + ".v", reference_v);
+        } else {
+            reference_k = ctx->load_cache_tensor(cache_prefix + ".k");
+            reference_v = ctx->load_cache_tensor(cache_prefix + ".v");
+            GGML_ASSERT(reference_k != nullptr && reference_v != nullptr);
+            reference_tokens = reference_k->ne[1];
+        }
+
+        const int64_t current_reference_tokens = extract ? reference_tokens : 0;
+        const int64_t current_image_start       = text_tokens + current_reference_tokens;
+        const int64_t image_tokens              = q->ne[1] - current_image_start;
+
+        auto q_text  = token_view_3d(ctx->ggml_ctx, q, 0, text_tokens);
+        auto q_image = token_view_3d(ctx->ggml_ctx, q, current_image_start, image_tokens);
+        auto q_main  = ggml_concat(ctx->ggml_ctx, q_text, q_image, 1);
+
+        ggml_tensor* k_all = k;
+        ggml_tensor* v_all = v;
+        if (!extract) {
+            auto k_text  = token_view_3d(ctx->ggml_ctx, k, 0, text_tokens);
+            auto k_image = token_view_3d(ctx->ggml_ctx, k, text_tokens, image_tokens);
+            auto v_text  = token_view_4d(ctx->ggml_ctx, v, 0, text_tokens);
+            auto v_image = token_view_4d(ctx->ggml_ctx, v, text_tokens, image_tokens);
+            k_all        = ggml_concat(ctx->ggml_ctx,
+                                ggml_concat(ctx->ggml_ctx, k_text, reference_k, 1),
+                                k_image,
+                                1);
+            v_all        = ggml_concat(ctx->ggml_ctx,
+                                ggml_concat(ctx->ggml_ctx, v_text, reference_v, 2),
+                                v_image,
+                                2);
+        }
+
+        auto main_attention = ggml_ext_attention_ext(ctx->ggml_ctx,
+                                                      ctx->backend,
+                                                      q_main,
+                                                      k_all,
+                                                      v_all,
+                                                      num_heads,
+                                                      nullptr,
+                                                      true,
+                                                      ctx->flash_attn_enabled);
+        if (!extract) {
+            return main_attention;
+        }
+
+        auto q_reference = token_view_3d(ctx->ggml_ctx, q, text_tokens, reference_tokens);
+        auto reference_attention = ggml_ext_attention_ext(ctx->ggml_ctx,
+                                                           ctx->backend,
+                                                           q_reference,
+                                                           reference_k,
+                                                           reference_v,
+                                                           num_heads,
+                                                           nullptr,
+                                                           true,
+                                                           ctx->flash_attn_enabled);
+        auto text_attention  = token_view_3d(ctx->ggml_ctx, main_attention, 0, text_tokens);
+        auto image_attention = token_view_3d(ctx->ggml_ctx, main_attention, text_tokens, image_tokens);
+        return ggml_concat(ctx->ggml_ctx,
+                           ggml_concat(ctx->ggml_ctx, text_attention, reference_attention, 1),
+                           image_attention,
+                           1);
+    }
